# Steam IDs in ID3 format (32-bit), one per line, without comma
ACCOUNT_IDS=""

"

# Target database file, relative to the script folder
DB_PATH=data/history.duckdb

# Data source
MANIFEST_URL=https://data.deadlock-api.com/v1/manifest.json
REQUEST_TIMEOUT=60

# Columns to load (avoid large array columns)
COLUMNS=match_id,start_time,duration_s,match_mode,account_id,team,hero_id,kills,deaths,assists,net_worth,last_hits,denies,player_level,won
